# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env
key.json

# Runtime outputs and local data
output/
examples/output/
jobs/*
!jobs/.gitkeep

# Local databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Local notebooks and logs often contain captured private data
*.ipynb
*.log

# Do not commit binary resumes or generated application documents
data/*.docx
data/*.pdf
demo_export*.json
