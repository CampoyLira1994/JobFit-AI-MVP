# API Keys for various services
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=False

# OpenAI keys
GPT_4O_API=your_openai_key_here
GPT_41_API=your_openai_key_here

# Search tools
TAVILY_API_KEY=your_tavily_key_here

# JobFit API search sources
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=mx
SERPAPI_API_KEY=your_serpapi_key
SERPAPI_GOOGLE_DOMAIN=google.com.mx
SERPAPI_GL=mx
SERPAPI_HL=es
SERPAPI_NO_CACHE=false

# LinkedIn credentials for scraping (REQUIRED)
LINKEDIN_USERNAME=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# Glassdoor credentials for scraping (OPTIONAL)
GLASSDOOR_USERNAME=your_glassdoor_email@example.com
GLASSDOOR_PASSWORD=your_glassdoor_password

# Logging level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO
